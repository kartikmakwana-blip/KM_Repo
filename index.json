                    "abo_vm_test_case_manual_steps": [
                        {
                            "step_id": "7158",
                            "tc_id": "1162",
                            "step_order": "1",
                            "step_action": "Open the URL https://www.rapidtables.com/tools/index.html in a browser.",
                            "created_at": "2026-11-03 06:47:31",
                            "updated_at": "2026-11-03 06:47:31"
                        }
                    ],
                    "cotester_chat_messages": [
                        {
                            "id": "1820",
                            "tc_id": "1162",
                            "thread_id": "",
                            "user_id": "100",
                            "message": "- Open the url : https://www.rapidtables.com/tools/index.html \n- Wait for 10 seconds till the “Alarm clock” element is visible.\n- Click on it.\n- Navigate to Alarm tab.\n- Click on arrow element to switch to PM/AM.\n- Wait for 3 seconds.\n- Go to settings.\n- Check the “Alarm settings” heading visible.\n- Tap on the Sound alarm toggle to Turn OFF.\n- Tap on the Vibration toggle to Turn ON.\n- Type in “Sample Alert Box” to the element “Text Alert”.  \n- Switch the Alarm volume to “80” \n- Click on Alarm tune dropdown element and select the 1st option.\n- Alarm test field - Click on Play button.",
                            "message_type": "sender",
                            "created_at": "2026-11-03 06:44:06",
                            "updated_at": "2026-11-03 06:44:06"
                        },
                        {
                            "id": "1821",
                            "tc_id": "1162",
                            "thread_id": "",
                            "user_id": "100",
                            "message": "Test Case: 1\n\nTest Case Title: Verify Alarm Clock Settings Functionality\nModule: Alarm Clock Tool\nPriority: Medium\n\nPreconditions:\n- User has access to https://www.rapidtables.com/tools/index.html\n- The device is connected to the internet\n- Required browser is installed and compatible\n\nTest Steps:\n1. Open the URL https://www.rapidtables.com/tools/index.html in a browser.\n2. Wait for 10 seconds until the “Alarm clock” element becomes visible on the tools index page.\n3. Click on the “Alarm clock” element.\n4. Navigate to the Alarm tab within the Alarm Clock tool.\n5. Click on the arrow element to switch between PM and AM.\n6. Wait for 3 seconds.\n7. Go to the settings section of the Alarm.\n8. Verify that the “Alarm settings” heading is visible.\n9. Tap the Sound alarm toggle to turn it OFF.\n10. Tap the Vibration toggle to turn it ON.\n11. Type “Sample Alert Box” into the “Text Alert” input field.\n12. Adjust the Alarm volume slider or input to “80”.\n13. Click the Alarm tune dropdown and select the 1st option from the list.\n14. In the Alarm test section, click the Play button.\n\nExpected Result:\n- The “Alarm clock” element is clickable after loading.\n- Alarm tab is accessible and displays PM/AM switching functionality.\n- “Alarm settings” heading is clearly displayed.\n- Sound alarm toggle is switched OFF successfully.\n- Vibration toggle is switched ON successfully.\n- The “Sample Alert Box” text is entered into the Text Alert field.\n- Alarm volume is set to 80 without error.\n- The Alarm tune dropdown accepts selection and the 1st option is chosen.\n- The play button in Alarm test field triggers the alarm sound or playback as expected.",
                            "message_type": "replier",
                            "created_at": "2026-11-03 06:44:14",
                            "updated_at": "2026-11-03 06:44:14"
                        }
                    ]
                }
            ],
